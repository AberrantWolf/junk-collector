# Use the published version/digest when supplied by the selected release.
# For a locally built image, use junk-collector:local.
COLLECTOR_IMAGE=junk-collector:local
COLLECTOR_DATA=/srv/junk-collector
# Starting config defaults to local-only HTTPS. The proxy config example replaces
# it before setup. For direct private HTTPS, set a stable host/IP and reserve it.
COLLECTOR_HOST=localhost
COLLECTOR_PRIVATE_IP=127.0.0.1

# Optional compose.inbox.yaml override; host ACL and GID grant actual read access.
# COMPOSE_FILE=compose.yaml:compose.inbox.yaml
# COLLECTOR_INBOX=/volume1/junk-collector-inbox
# COLLECTOR_INBOX_GID=65538
