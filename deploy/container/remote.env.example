# Copy to /etc/junk-collector/remote.env, mode 0600. Values are examples only.
# Do not source this in a shell. systemd EnvironmentFile and Compose read it.
COLLECTOR_DATA=/var/lib/junk-collector
COLLECTOR_CONFIG=/var/lib/junk-collector/config
COLLECTOR_STATE=/var/lib/junk-collector/state
COLLECTOR_BACKUPS=/var/lib/junk-collector/backups
COLLECTOR_ARCHIVE=/srv/junk-collector/archive
COLLECTOR_INBOX=/srv/junk-collector/inbox
COLLECTOR_ARCHIVE_SOURCE=FatChocobo:/REPLACE/archive-export
COLLECTOR_INBOX_SOURCE=FatChocobo:/REPLACE/inbox-export
COLLECTOR_ARCHIVE_ID=REPLACE_WITH_ARCHIVE_IDENTITY_UUID
COLLECTOR_ARCHIVE_GID=65538
COLLECTOR_INBOX_GID=65538
COLLECTOR_INBOX_READ_ONLY=true
COLLECTOR_IMAGE=REPLACE_WITH_QUALIFIED_DIGEST
COLLECTOR_MEDIA_IMAGE=REPLACE_WITH_QUALIFIED_MEDIA_DIGEST
COLLECTOR_CONTROL_ORIGIN=https://RETAIN_EXISTING_CONTROL_HOST
COLLECTOR_MEDIA_HOST=RETAIN_EXISTING_MEDIA_HOST
COLLECTOR_MEDIA_BIND_IP=REPLACE_WITH_FI_PRIVATE_IP
